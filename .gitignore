# Datos persistentes de PostgreSQL
/volumes/postgres/

# Dependencias de Laravel
/app/vendor/
/app/node_modules/

# Entorno de infraestructura (docker-compose)
/.env
/.env.backup

# Entorno Laravel
/app/.env
/app/.env.backup
/app/.phpunit.result.cache

# Laravel: cachés, logs y storage generado
/app/bootstrap/cache/*
!/app/bootstrap/cache/.gitkeep
/app/storage/*.key
/app/storage/app/*
!/app/storage/app/public
/app/storage/framework/cache/*
/app/storage/framework/sessions/*
/app/storage/framework/testing/*
/app/storage/framework/views/*
!/app/storage/framework/cache/.gitkeep
!/app/storage/framework/sessions/.gitkeep
!/app/storage/framework/testing/.gitkeep
!/app/storage/framework/views/.gitkeep
/app/storage/logs/*
!/app/storage/logs/.gitkeep
/app/public/hot
/app/public/storage
/app/public/build/

# CA corporativo local (proxy con inspección TLS): solo hace falta para
# buildear detrás de esa red. No debe hornearse en la imagen del VPS.
/docker/php/certs/*
!/docker/php/certs/.gitkeep

# Basura de debugging (curl, etc.)
cookies.txt

# Documentación pesada: se guarda local, no viaja en el repo/clon del VPS
/manual_mvp.docx
/capturas.rar

# IDE / SO
.idea/
.vscode/
.DS_Store
Thumbs.db
